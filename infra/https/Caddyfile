portal.local {
    tls internal

    # Health (sem prefixo)
    handle /health {
        reverse_proxy 127.0.0.1:8010
    }

    # Swagger/OpenAPI (FastAPI fica na raiz)
    handle /docs* {
        reverse_proxy 127.0.0.1:8010
    }
    handle /openapi.json {
        reverse_proxy 127.0.0.1:8010
    }
    handle /redoc* {
        reverse_proxy 127.0.0.1:8010
    }

    # API v1 (preserva /api/v1 no upstream)
    handle /api/v1/* {
        reverse_proxy 127.0.0.1:8010
    }

    # SPA por último
    handle {
        root * ../../frontend/dist
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=3600"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'"
    }
}
