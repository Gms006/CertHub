portal.local {
    tls internal

    @api path /api/v1/*
    reverse_proxy @api 127.0.0.1:8010

    root * ../../frontend/dist
    try_files {path} /index.html
    file_server

    header {
        Strict-Transport-Security "max-age=3600"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'"
    }
}
