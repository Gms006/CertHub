ENV=dev

# DB
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/certhub

# Redis/RQ
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=default

# Multi-tenant (se já tiver org_id/GUC no seu core)
DEFAULT_ORG_ID=1

# Catálogo de certificados (catálogo/ingest)
CERTS_ROOT_PATH=SEU_DIRETORIO_DE_CERTIFICADOS_AQUI
OPENSSL_PATH=C:\Program Files\OpenSSL-Win64\bin\openssl.exe

# JWT (S2)
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MIN=30
DEVICE_TOKEN_TTL_MIN=10
REFRESH_TTL_DAYS=14
SET_PASSWORD_TOKEN_TTL_MIN=10
RESET_PASSWORD_TOKEN_TTL_MIN=30
BCRYPT_COST=12
RETENTION_KEEP_UNTIL_MAX_HOURS=24
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
COOKIE_HTTPONLY=true
ALLOW_LEGACY_HEADERS=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8011,http://192.168.25.51:5173

# Email (S5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=SEU_EMAIL_DE_ENVIO_AQUI
SMTP_PASS=SUA_SENHA_DE_APP_AQUI
SMTP_FROM="CertHub <email_de_envio_aqui>"

FRONTEND_BASE_URL=http://SEU_FRONTEND_AQUI

# Integração eControle (webhook)
ECONTROLE_WEBHOOK_ENABLED=false
ECONTROLE_WEBHOOK_URL=http://127.0.0.1:8020/api/v1/integracoes/certhub/webhook
ECONTROLE_WEBHOOK_TOKEN=SEU_TOKEN_AQUI
ECONTROLE_WEBHOOK_VERIFY_TLS=true
# Opcional: usa org_id como fallback quando não definido
# ECONTROLE_WEBHOOK_ORG_SLUG=seu-org-slug
# ECONTROLE_WEBHOOK_ORG_SLUG_MAP=1:matriz,2:filial-sp
